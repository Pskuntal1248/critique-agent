# App
APP_NAME=Critique
LOG_LEVEL=INFO
ENVIRONMENT=development          # development | production

# Database
DATABASE_URL=postgresql+asyncpg://critique:critique@localhost:5432/critique

# LLM — primary provider
LLM_PROVIDER=anthropic           # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                  # always required for openai provider; optional for anthropic

# Agent tuning
MAX_REVISIONS=3                  # max analyst/critic retry cycles
CRITIC_APPROVAL_THRESHOLD=0.75   # score >= this passes to writer
MAX_RESEARCH_RESULTS=5           # max web search results per subtask
REQUEST_TIMEOUT_SECONDS=30       # per-tool HTTP timeout

# Auth — leave empty to disable, set a value to require X-API-Key header
# NOTE: SSE streaming uses ?api_key= query param as fallback for browser EventSource
API_KEY=

# CORS — comma-separated allowed origins for the Next.js frontend
# Add your deploy URL (e.g. https://critique.railway.app) when deploying
CORS_ORIGINS=http://localhost:3000

# Human-in-the-loop — set true to require human approval before Writer step
HUMAN_IN_LOOP=false

# Celery + Redis (task queue for LangGraph worker process)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Tavily (optional alternative to DuckDuckGo)
TAVILY_API_KEY=                  # leave empty to use DuckDuckGo (free)
