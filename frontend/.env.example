# URL of the Critique FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: API key if API_KEY is set on the backend
# Leave empty when API_KEY is not configured (default).
# NOTE: SSE streaming (EventSource) cannot send custom headers.
# If you enable API_KEY on the backend, either disable auth for
# the /tasks/{id}/stream endpoint, or leave this empty and rely
# on the backend default of no auth.
NEXT_PUBLIC_API_KEY=
